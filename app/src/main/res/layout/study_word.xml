<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="25dp"
    android:paddingVertical="50dp">

    <ImageView
        android:id="@+id/word_img"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#404040"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:paddingTop="5dp">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/word_eng_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/eng_bg" />

            <TextView
                android:id="@+id/word_eng_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="20sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="70dp">

            <ImageView
                android:id="@+id/word_kr_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/eng_bg" />

            <TextView
                android:id="@+id/word_kr_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />
        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/word_pro_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/eng_bg" />

        <TextView
            android:id="@+id/word_pro_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:paddingTop="20dp">

        <ImageButton
            android:id="@+id/listenButton"
            android:layout_width="130dp"
            android:layout_height="70dp"
            android:src="@drawable/btn_listening"
            android:contentDescription="Listen"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:padding="0dp"/>

        <ImageButton
            android:id="@+id/speakButton"
            android:layout_width="130dp"
            android:layout_height="70dp"
            android:src="@drawable/btn_speaking"
            android:contentDescription="Speak"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:padding="0dp"/>
    </LinearLayout>

</LinearLayout>